@page "/Rooms"
@model MyRazorApp.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Sơ đồ phòng & giá - AHoLa Hotel";
    var statusClasses = new Dictionary<string, string> { ["Trống"] = "available", ["Đã đặt"] = "booked", ["Đang ở"] = "occupied", ["Đang dọn"] = "cleaning", ["Bảo trì"] = "maintenance" };
}

<div class="rooms-page">
    <div class="container-fluid px-4 px-xl-5 py-5">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
            <div><div class="eyebrow mb-2">AHOLA HOTEL · KHÔNG GIAN LƯU TRÚ</div><h1 class="page-title mb-2">Sơ đồ phòng & bảng giá</h1><p class="text-secondary mb-0">Xem trạng thái, hình ảnh và giá phòng theo từng tầng.</p></div>
            <a asp-page="/Index" class="btn btn-light border rounded-3 px-3"><i class="bi bi-arrow-left me-2"></i>Tổng quan</a>
        </div>

        <div class="room-toolbar mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="room-filters" role="group" aria-label="Lọc phòng theo trạng thái">
                    <button class="filter-button active" data-filter="all">Tất cả <span>20</span></button>
                    <button class="filter-button" data-filter="Trống">Trống <span>9</span></button>
                    <button class="filter-button" data-filter="Đã đặt">Đã đặt <span>4</span></button>
                    <button class="filter-button" data-filter="Đang ở">Đang ở <span>3</span></button>
                    <button class="filter-button" data-filter="Đang dọn">Đang dọn <span>2</span></button>
                    <button class="filter-button" data-filter="Bảo trì">Bảo trì <span>2</span></button>
                </div>
                <div class="small text-secondary"><i class="bi bi-arrow-up me-1"></i>Giá tăng dần theo tầng</div>
            </div>
        </div>

        @for (var floor = 1; floor <= 4; floor++)
        {
            var floorRooms = Model.Rooms.Where(r => r.Floor == floor).ToList();
            <section class="floor-section mb-5" data-floor="@floor">
                <div class="floor-heading"><div><span class="floor-kicker">KHU VỰC PHÒNG</span><h2 class="floor-title">Tầng @floor</h2></div><span class="floor-price">Từ @floorRooms.Min(r => r.Price).ToString("N0") ₫ / đêm</span></div>
                <div class="row g-4">
                    @foreach (var room in floorRooms)
                    {
                        var color = statusClasses[room.Status];
                        <div class="col-sm-6 col-xl-4 col-xxl-3 room-item" data-status="@room.Status">
                            <article class="room-card h-100">
                                <div class="room-image-wrap"><img class="room-image" src="@room.ImageUrl" alt="Ảnh minh họa phòng @room.Number" loading="lazy" /><span class="room-status @color"><i class="bi bi-circle-fill"></i>@room.Status</span><button class="room-favorite" type="button" aria-label="Đánh dấu yêu thích"><i class="bi bi-heart"></i></button></div>
                                <div class="room-card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2"><div><div class="room-type">@room.Type</div><h3 class="room-name">Phòng @room.Number</h3><div class="room-location"><i class="bi bi-geo-alt me-1"></i>Tầng @room.Floor · Cánh @(room.Number % 2 == 0 ? "Đông" : "Tây")</div></div><span class="room-capacity"><i class="bi bi-people"></i> 2</span></div>
                                    <div class="room-card-divider"></div>
                                    <div class="d-flex align-items-end justify-content-between"><div><span class="room-price">@room.Price.ToString("N0") ₫</span><span class="room-price-unit"> / đêm</span></div><div class="room-rating"><i class="bi bi-star-fill"></i><strong>@room.Rating.ToString("0.0")</strong></div></div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </section>
        }
        <div id="noRooms" class="text-center text-secondary py-5 d-none">Không có phòng ở trạng thái này.</div>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const buttons = document.querySelectorAll('.filter-button');
        const cards = document.querySelectorAll('.room-item');
        const floors = document.querySelectorAll('.floor-section');
        const empty = document.getElementById('noRooms');
        buttons.forEach(button => button.addEventListener('click', () => {
            buttons.forEach(item => item.classList.toggle('active', item === button));
            let visible = 0;
            cards.forEach(card => {
                const show = button.dataset.filter === 'all' || card.dataset.status === button.dataset.filter;
                card.classList.toggle('d-none', !show);
                if (show) visible++;
            });
            floors.forEach(floor => floor.classList.toggle('d-none', !floor.querySelector('.room-item:not(.d-none)')));
            empty.classList.toggle('d-none', visible > 0);
        }));
        document.querySelectorAll('.room-favorite').forEach(button => button.addEventListener('click', () => {
            button.classList.toggle('selected');
            button.innerHTML = button.classList.contains('selected') ? '<i class="bi bi-heart-fill"></i>' : '<i class="bi bi-heart"></i>';
        }));
    })();
</script>
}
