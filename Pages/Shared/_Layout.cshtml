<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AHoLa Hotel</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyRazorApp.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- ================= HEADER & NAVBAR ================= -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark shadow" style="background: linear-gradient(135deg, #1a1c29 0%, #282c40 100%); backdrop-filter: blur(10px);">
            <div class="container-fluid px-4">

                <!-- Logo & Brand -->
                <a class="navbar-brand d-flex align-items-center fw-bold" asp-area="" asp-page="/Index">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 40px; height: 40px;">
                        <i class="bi bi-building-fill fs-5"></i>
                    </div>
                    <div class="lh-1">
                        <span class="fs-4 text-gradient" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">AHoLa</span>
                        <span class="fs-6 text-light opacity-75 fw-normal d-block" style="font-size: 10px !important; letter-spacing: 1px;">HOTEL SYSTEM</span>
                    </div>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
                        
                        <!-- Trang chủ / Tổng quan -->
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-light hover-bg-light" asp-page="/Products/Index">
                                <i class="bi bi-speedometer2 me-1 text-primary"></i> Tổng quan
                            </a>
                        </li>

                        <!-- 1. Hệ thống -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 rounded-pill text-light hover-bg-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear-wide-connected me-1 text-info"></i> 1. Hệ thống
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-0 rounded-3 mt-2">
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Accounts/Accounts">
                                        <i class="bi bi-person-badge me-2 text-primary"></i> Tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Employees/Employees">
                                        <i class="bi bi-people me-2 text-info"></i> Nhân viên
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Permissions/Permissions">
                                        <i class="bi bi-shield-lock me-2 text-warning"></i> Phân quyền
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 2. Quản lý Phòng -->
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-light hover-bg-light" asp-page="/Rooms/Index">
                                <i class="bi bi-door-open me-1 text-warning"></i> 2. Phòng
                            </a>
                        </li>

                        <!-- 3. Khách hàng & Đặt phòng -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 rounded-pill text-light hover-bg-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-calendar-check me-1 text-success"></i> 3. Đặt phòng
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-0 rounded-3 mt-2">
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Bookings/Customers">
                                        <i class="bi bi-person-lines-fill me-2 text-info"></i> Khách hàng
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Bookings/Index">
                                        <i class="bi bi-journal-bookmark me-2 text-primary"></i> Danh sách đặt phòng
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 4. Lưu trú & Dịch vụ -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3 rounded-pill text-light hover-bg-light" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-concierge-bell me-1 text-danger"></i> 4. Lưu trú & Dịch vụ
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-0 rounded-3 mt-2">
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Stays/CheckIn">
                                        <i class="bi bi-box-arrow-in-right me-2 text-success"></i> Nhận phòng
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Stays/ActiveStays">
                                        <i class="bi bi-house-check me-2 text-info"></i> Khách đang lưu trú
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider opacity-25"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Services/Catalog">
                                        <i class="bi bi-list-stars me-2 text-warning"></i> Danh mục dịch vụ
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-page="/Services/Record">
                                        <i class="bi bi-receipt-cutoff me-2 text-danger"></i> Ghi nhận dịch vụ
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Chính sách -->
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-light hover-bg-light" asp-page="/Privacy">
                                <i class="bi bi-shield-check me-1 text-secondary"></i> Chính sách
                            </a>
                        </li>

                    </ul>

                    <!-- Right Controls: Notification & Admin Info -->
                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        <!-- Thông báo -->
                        <div class="dropdown">
                            <a href="#" class="text-light position-relative text-decoration-none px-2" data-bs-toggle="dropdown">
                                <i class="bi bi-bell fs-5"></i>
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow-lg border-0 rounded-3 mt-2 p-2" style="width: 270px;">
                                <li class="small fw-bold text-muted px-2 pb-1 border-bottom">Thông báo mới</li>
                                <li><a class="dropdown-item rounded-2 py-2 small text-wrap mt-1" href="#"><i class="bi bi-info-circle text-warning me-1"></i> 3 lượt đặt phòng mới chưa check-in.</a></li>
                            </ul>
                        </div>

                        <!-- Kẻ đứng ngăn cách -->
                        <div class="vr bg-secondary opacity-50 d-none d-lg-block" style="height: 24px;"></div>

                        <!-- Thông tin Admin / Avatar -->
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-light" data-bs-toggle="dropdown" aria-expanded="false">
                                <!-- Khung tròn căn giữa icon tuyệt đối (flex-shrink: 0 ngăn bị bóp méo) -->
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2 shadow-sm flex-shrink-0" style="width: 36px; height: 36px;">
                                    <i class="bi bi-person-fill fs-6 lh-1"></i>
                                </div>
                                <div class="text-start d-none d-sm-block me-1">
                                    <span class="d-block fw-bold small text-white lh-sm">AHola Admin</span>
                                    <span class="d-block text-white-50" style="font-size: 11px; line-height: 1.2;">Quản trị viên</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow-lg border-0 rounded-3 mt-2">
                                <li><a class="dropdown-item py-2" href="#"><i class="bi bi-person me-2 text-primary"></i>Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item py-2" href="#"><i class="bi bi-sliders me-2 text-info"></i>Cài đặt</a></li>
                                <li><hr class="dropdown-divider opacity-25"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN CONTENT ================= -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="border-top footer bg-white text-muted py-3">
        <div class="container text-center text-md-start">
            <div class="row align-items-center">
                <div class="col-md-6">
                    &copy; 2026 - <strong>AHoLa Hotel Management</strong> - <a asp-area="" asp-page="/Privacy" class="text-decoration-none">Chính sách bảo mật</a>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Hệ thống đang hoạt động tốt</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- CSS bổ trợ cho hiệu ứng Menu -->
    <style>
        .hover-bg-light:hover {
            background-color: rgba(255, 255, 255, 0.1) !important;
            transition: background-color 0.2s ease-in-out;
        }
        .dropdown-item:hover {
            background-color: rgba(255, 255, 255, 0.15);
        }
    </style>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
