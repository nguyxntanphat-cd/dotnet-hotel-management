@page
@model MyRazorApp.Pages.Services.CatalogModel
@{
    ViewData["Title"] = "Danh mục Dịch vụ - AHoLa Hotel";
}
@functions {
    // Màu badge theo nhóm dịch vụ
    string CategoryBadge(string category) => category switch
    {
        "Ăn uống" => "bg-success-subtle text-success border-success-subtle",
        "Giặt ủi" => "bg-info-subtle text-info border-info-subtle",
        "Spa & Làm đẹp" => "bg-danger-subtle text-danger border-danger-subtle",
        "Đưa đón" => "bg-warning-subtle text-warning border-warning-subtle",
        "Giải trí" => "bg-primary-subtle text-primary border-primary-subtle",
        _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
    };

    string CategoryIcon(string category) => category switch
    {
        "Ăn uống" => "bi-cup-hot",
        "Giặt ủi" => "bi-basket",
        "Spa & Làm đẹp" => "bi-flower1",
        "Đưa đón" => "bi-car-front",
        "Giải trí" => "bi-controller",
        _ => "bi-grid"
    };
}

<div class="services-container container-fluid py-4 px-4">

    <!-- 1. TIÊU ĐỀ TRANG & NÚT THAO TÁC -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-list-stars text-warning me-2"></i>Danh Mục Dịch Vụ
            </h2>
            <p class="text-muted mb-0">Lưu trữ danh sách dịch vụ, đơn giá và đơn vị tính được cung cấp tại AHoLa Hotel.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                <i class="bi bi-plus-circle me-1"></i> Thêm Dịch Vụ
            </button>
        </div>
    </div>

    <!-- 2. THỐNG KÊ NHANH -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="kpi kpi--primary">
                <div class="kpi-head">
                    <span class="kpi-label">Tổng dịch vụ</span>
                    <span class="kpi-icon"><i class="bi bi-list-ul"></i></span>
                </div>
                <div class="kpi-value"><span data-count>@Model.TotalCount</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="kpi kpi--success">
                <div class="kpi-head">
                    <span class="kpi-label">Đang cung cấp</span>
                    <span class="kpi-icon"><i class="bi bi-check-circle"></i></span>
                </div>
                <div class="kpi-value"><span data-count>@Model.ActiveCount</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="kpi kpi--warning">
                <div class="kpi-head">
                    <span class="kpi-label">Tạm ngưng</span>
                    <span class="kpi-icon"><i class="bi bi-pause-circle"></i></span>
                </div>
                <div class="kpi-value"><span data-count>@Model.PausedCount</span></div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="kpi kpi--info">
                <div class="kpi-head">
                    <span class="kpi-label">Nhóm dịch vụ</span>
                    <span class="kpi-icon"><i class="bi bi-tags"></i></span>
                </div>
                <div class="kpi-value"><span data-count>@Model.CategoryCount</span></div>
            </div>
        </div>
    </div>

    <!-- 3. BỘ LỌC & TÌM KIẾM -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Tìm theo mã, tên, mô tả dịch vụ...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="CategoryFilter" class="form-select">
                        <option value="">-- Tất cả nhóm dịch vụ --</option>
                        @foreach (var c in CatalogModel.Categories)
                        {
                            <option value="@c" selected="@(Model.CategoryFilter == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="StatusFilter" class="form-select">
                        <option value="">-- Trạng thái --</option>
                        <option value="Đang cung cấp" selected="@(Model.StatusFilter == "Đang cung cấp")">Đang cung cấp</option>
                        <option value="Tạm ngưng" selected="@(Model.StatusFilter == "Tạm ngưng")">Tạm ngưng</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button type="submit" class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4. BẢNG DANH SÁCH DỊCH VỤ -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Mã DV</th>
                            <th class="py-3">Tên Dịch Vụ</th>
                            <th class="py-3">Nhóm</th>
                            <th class="py-3 text-end">Đơn Giá</th>
                            <th class="py-3">Đơn Vị</th>
                            <th class="py-3">Trạng Thái</th>
                            <th class="pe-4 py-3 text-end">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ServicesList.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy dịch vụ nào.
                                </td>
                            </tr>
                        }
                        @foreach (var sv in Model.ServicesList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@sv.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="service-icon rounded-3 border me-3 d-flex align-items-center justify-content-center @CategoryBadge(sv.Category)">
                                            <i class="bi @CategoryIcon(sv.Category)"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">@sv.Name</h6>
                                            <small class="text-muted">@sv.Description</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge border px-2 py-1 @CategoryBadge(sv.Category)">@sv.Category</span>
                                </td>
                                <td class="text-end fw-bold text-dark">@sv.PriceText</td>
                                <td class="small text-muted">/ @sv.Unit</td>
                                <td>
                                    @if (sv.Status == "Đang cung cấp")
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-dot"></i> Đang cung cấp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill">
                                            <i class="bi bi-pause-fill me-1"></i> Tạm ngưng
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <!-- 1. Nút Sửa -->
                                        <button type="button" class="btn btn-sm btn-light text-primary btn-edit-service" title="Chi tiết/Sửa"
                                                data-id="@sv.Id"
                                                data-name="@sv.Name"
                                                data-category="@sv.Category"
                                                data-price="@sv.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"
                                                data-unit="@sv.Unit"
                                                data-description="@sv.Description"
                                                data-status="@sv.Status"
                                                data-bs-toggle="modal" data-bs-target="#editServiceModal">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <!-- 2. Nút Đổi Trạng Thái Nhanh -->
                                        <form method="post" asp-page-handler="ToggleStatus" class="d-inline">
                                            <input type="hidden" name="id" value="@sv.Id" />
                                            @if (sv.Status == "Đang cung cấp")
                                            {
                                                <button type="submit" class="btn btn-sm btn-light text-warning" title="Tạm ngưng dịch vụ">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-light text-success" title="Mở lại dịch vụ">
                                                    <i class="bi bi-play-circle"></i>
                                                </button>
                                            }
                                        </form>

                                        <!-- 3. Nút Xóa -->
                                        <button type="button" class="btn btn-sm btn-light text-danger btn-delete-service" title="Xóa dịch vụ"
                                                data-id="@sv.Id"
                                                data-name="@sv.Name"
                                                data-bs-toggle="modal" data-bs-target="#deleteServiceModal">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-top py-3 px-4">
            <span class="small text-muted">Hiển thị @Model.ServicesList.Count trong tổng số @Model.TotalCount dịch vụ</span>
        </div>
    </div>

</div>

<!-- ======================= MODAL SYSTEM ======================= -->

<!-- 1. MODAL THÊM DỊCH VỤ -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-plus-square text-primary me-2"></i>Thêm Dịch Vụ Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-medium small">Tên dịch vụ</label>
                            <input type="text" class="form-control" name="NewService.Name" placeholder="VD: Buffet tối" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Mã dịch vụ</label>
                            <input type="text" class="form-control bg-light" value="@CatalogModel.NextId()" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Nhóm dịch vụ</label>
                            <select class="form-select" name="NewService.Category" required>
                                @foreach (var c in CatalogModel.Categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Đơn giá (VNĐ)</label>
                            <input type="number" class="form-control" name="NewService.Price" min="0" step="1000" placeholder="150000" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Đơn vị tính</label>
                            <select class="form-select" name="NewService.Unit" required>
                                @foreach (var u in CatalogModel.Units)
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium small">Mô tả</label>
                            <textarea class="form-control" name="NewService.Description" rows="2" placeholder="Thời gian phục vụ, ghi chú..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium small">Trạng thái ban đầu</label>
                            <select class="form-select" name="NewService.Status" required>
                                <option value="Đang cung cấp">Đang cung cấp</option>
                                <option value="Tạm ngưng">Tạm ngưng</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Lưu Dịch Vụ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. MODAL CHỈNH SỬA DỊCH VỤ -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Dịch Vụ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editServiceId" name="EditService.Id" />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-medium small">Tên dịch vụ</label>
                            <input type="text" id="editServiceName" class="form-control" name="EditService.Name" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Mã dịch vụ</label>
                            <input type="text" id="editServiceIdView" class="form-control bg-light" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Nhóm dịch vụ</label>
                            <select id="editServiceCategory" class="form-select" name="EditService.Category" required>
                                @foreach (var c in CatalogModel.Categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Đơn giá (VNĐ)</label>
                            <input type="number" id="editServicePrice" class="form-control" name="EditService.Price" min="0" step="1000" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium small">Đơn vị tính</label>
                            <select id="editServiceUnit" class="form-select" name="EditService.Unit" required>
                                @foreach (var u in CatalogModel.Units)
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium small">Mô tả</label>
                            <textarea id="editServiceDescription" class="form-control" name="EditService.Description" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium small">Trạng thái</label>
                            <select id="editServiceStatus" class="form-select" name="EditService.Status" required>
                                <option value="Đang cung cấp">Đang cung cấp</option>
                                <option value="Tạm ngưng">Tạm ngưng</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Cập Nhật Dịch Vụ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. MODAL XÓA DỊCH VỤ -->
<div class="modal fade" id="deleteServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form method="post" asp-page-handler="Delete">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Dịch Vụ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteServiceId" name="id" />
                    <p class="mb-1 text-dark">Bạn có chắc chắn muốn xóa dịch vụ <strong id="deleteServiceName" class="text-danger"></strong> không?</p>
                    <small class="text-muted">Nếu chỉ muốn ngừng bán tạm thời, hãy dùng nút "Tạm ngưng" thay vì xóa.</small>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Xóa Dịch Vụ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // 1. Gán dữ liệu vào Modal Chỉnh sửa Dịch vụ
            document.querySelectorAll(".btn-edit-service").forEach(button => {
                button.addEventListener("click", function () {
                    document.getElementById("editServiceId").value = this.getAttribute("data-id");
                    document.getElementById("editServiceIdView").value = this.getAttribute("data-id");
                    document.getElementById("editServiceName").value = this.getAttribute("data-name");
                    document.getElementById("editServiceCategory").value = this.getAttribute("data-category");
                    document.getElementById("editServicePrice").value = this.getAttribute("data-price");
                    document.getElementById("editServiceUnit").value = this.getAttribute("data-unit");
                    document.getElementById("editServiceDescription").value = this.getAttribute("data-description");
                    document.getElementById("editServiceStatus").value = this.getAttribute("data-status");
                });
            });

            // 2. Gán dữ liệu vào Modal Xóa Dịch vụ
            document.querySelectorAll(".btn-delete-service").forEach(button => {
                button.addEventListener("click", function () {
                    document.getElementById("deleteServiceId").value = this.getAttribute("data-id");
                    document.getElementById("deleteServiceName").textContent = this.getAttribute("data-name");
                });
            });

        });
    </script>
}
